generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions      Session[]
  perfisFiscais  PerfilFiscal[]
  fontesDeRenda  FonteDeRenda[]
  atividades     Atividade[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PerfilFiscalTipo {
  PF
  PJ
}

enum RegimeTributario {
  PF_AUTONOMO
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
}

enum ModeloRemuneracao {
  FIXO_MENSAL
  POR_ATIVIDADE
  POR_UNIDADE
}

enum TipoAtividade {
  PLANTAO
  CONSULTA
  PROCEDIMENTO
  OUTRO
}

model PerfilFiscal {
  id              String            @id @default(cuid())
  userId          String
  tipo            PerfilFiscalTipo
  regime          RegimeTributario
  aliquotaEfetiva Float
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fontesDeRenda   FonteDeRenda[]
}

enum StatusAtividade {
  AGENDADA
  REALIZADA
  CANCELADA
}

model FonteDeRenda {
  id                String              @id @default(cuid())
  userId            String
  perfilFiscalId    String
  nome              String
  modelo            ModeloRemuneracao
  valorMensal       Float?
  valorPorAtividade Float?
  prazoPagamentoDias Int                @default(30)
  ativa             Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  perfilFiscal     PerfilFiscal      @relation(fields: [perfilFiscalId], references: [id], onDelete: Restrict)
  precos           PrecoAtividade[]
  atividades       Atividade[]
}

model PrecoAtividade {
  id             String         @id @default(cuid())
  fonteDeRendaId String
  tipo           TipoAtividade
  valor          Float

  fonteDeRenda   FonteDeRenda   @relation(fields: [fonteDeRendaId], references: [id], onDelete: Cascade)

  @@unique([fonteDeRendaId, tipo])
}

model Atividade {
  id             String          @id @default(cuid())
  userId         String
  fonteDeRendaId String
  tipo           TipoAtividade
  data           DateTime
  status         StatusAtividade @default(AGENDADA)
  valor          Float
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fonteDeRenda   FonteDeRenda    @relation(fields: [fonteDeRendaId], references: [id], onDelete: Restrict)
}