# Database
DATABASE_URL="file:./dev.db"

# ─── Produção (Docker / multi-instância) ─────────────────────────────────────
# Em vez de DATABASE_URL, cada container define DATABASE_PATH apontando para
# o arquivo SQLite no volume persistente. O app constrói a URL internamente.
# Exemplo:
#   DATABASE_PATH=/data/cliente.db
#
# Chave secreta usada para assinar cookies de sessão (produção).
# Gere com: openssl rand -base64 32
# AUTH_SECRET=